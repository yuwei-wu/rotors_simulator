<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- Only one ROS interface plugin is required per world, as any other plugin can connect a Gazebo
         topic to a ROS topic (or vise versa). -->
    <plugin name="ros_interface_plugin" filename="librotors_gazebo_ros_interface_plugin.so"/>

    <model name='gd1'>
      <static>1</static>
      <link name='chassis'>
        <pose frame=''>20 20 -0.1 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box>
              <size>40 40 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://ground_surface/meshes/simple_box.dae</uri>
              <scale>40 40 0.2</scale>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>model://ground_surface/materials/scripts</uri>
              <uri>model://ground_surface/materials/textures</uri>
              <name>BrickBox/Ground</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <kinematic>0</kinematic>
      </link>
    </model>


