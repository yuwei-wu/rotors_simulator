<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='default'>
    <!-- Only one ROS interface plugin is required per world, as any other plugin can connect a Gazebo
         topic to a ROS topic (or vise versa). -->
    <!-- <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose frame=''>0 0 40 0 -0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 -0.5 -1</direction>
    </light> -->



    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose frame=''>0 0 50 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>
    <!-- A ground plane -->
    <!-- <include>
      <uri>model://ground_plane</uri>
    </include> -->

    <!-- Only one ROS interface plugin is required per world, as any other plugin can connect a Gazebo
         topic to a ROS topic (or vise versa). -->
    <plugin name="ros_interface_plugin" filename="librotors_gazebo_ros_interface_plugin.so"/>

    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>1</shadows>
      <origin_visual>0</origin_visual>
      <grid>0</grid>
      <sky>
        <clouds>
          <speed>-4</speed>
        </clouds>
      </sky>
    </scene>  
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>218.674 28.4041 66.9437 0 0.275643 3.14159</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>


    <model name='orchard_world'>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <scale>3.3 3.3 3.3</scale>
              <uri>model://orchard_world/orchard_world.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <scale>3.3 3.3 3.3</scale>
              <uri>model://orchard_world/orchard_world.dae</uri>
            </mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
      <pose>-62.722168 135.521393 0.0 0 -0 -1.57</pose>
    </model>
    <model name='orchard_trunks'>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <scale>3.3 3.3 3.3</scale>
              <uri>model://orchard_trunks/orchard_trunks.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <scale>3.3 3.3 3.3</scale>
              <uri>model://orchard_trunks/orchard_trunks.dae</uri>
            </mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
      <pose>-62.722168 135.521393 0.0 0 -0 -1.57</pose>
    </model>
    <model name='orchard_leaves'>
      <static>1</static>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <scale>3.3 3.3 3.3</scale>
              <uri>model://orchard_leaves/orchard_leaves.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <scale>3.3 3.3 3.3</scale>
              <uri>model://orchard_leaves/orchard_leaves.dae</uri>
            </mesh>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
      <pose>-62.722168 135.521393 0.0 0 -0 -1.57</pose>
    </model>    



    <!-- First Moving Target -->
    <include>
      <uri>model://car_1</uri>
      <pose>-5 -5 0.5 0 -0 0</pose>
      <name>car_1</name>
    </include>

    <!-- Second Moving Target -->
    <include>
      <uri>model://car_2</uri>
      <pose>5 -5 0.5 0 -0 0</pose>
      <name>car_2</name>
    </include>

    <!-- Third Moving Target -->
    <include>
      <uri>model://car_3</uri>
      <pose>15 -5 0.5 0 -0 0</pose>
      <name>car_3</name>
    </include>

    <!-- Fourth Moving Target -->
    <include>
      <uri>model://car_4</uri>
      <pose>25 -5 0.5 0 -0 0</pose>
      <name>car_4</name>
    </include>

    <!-- Fifth Moving Target -->
    <include>
      <uri>model://car_5</uri>
      <pose>35 -5 0.5 0 -0 0</pose>
      <name>car_5</name>
    </include>

    <!-- Sixth Moving Target -->
    <include>
      <uri>model://car_6</uri>
      <pose>45 -5 0.5 0 -0 0</pose>
      <name>car_6</name>
    </include>




  </world>
</sdf>
