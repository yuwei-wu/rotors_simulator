    <!-- Random Walking Actor -->
    <actor name='random_walker'>
      <pose>10 5 1.2138 0 0 0</pose>
      <skin>
        <filename>moonwalk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name='walking'>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <plugin name="actor_plugin" filename="libgazebo_ros_actor_command.so">
        <!-- path mode + region_random_walker_publisher.py: bounded random walk
             inside a region, instead of unbounded velocity-driven roaming. -->
        <follow_mode>path</follow_mode>
        <vel_topic>/random_walker/cmd_vel</vel_topic>
        <path_topic>/random_walker/cmd_path</path_topic>
        <animation_factor>4.0</animation_factor>
        <linear_tolerance>0.3</linear_tolerance>
        <linear_velocity>1.0</linear_velocity>
        <angular_tolerance>0.0872</angular_tolerance>
        <angular_velocity>2.5</angular_velocity>
        <default_rotation>1.57</default_rotation>
      </plugin>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>10 5 1.2138 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>5</time>
            <pose>20 5 1.2138 0 0 0</pose>
          </waypoint>
