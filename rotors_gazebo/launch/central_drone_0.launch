<launch>
    <!-- Parameters -->
    <arg name="robot_num" default="2"/>
    <arg name="target_num" default="2"/>
    <arg name="win_size" default="10"/>
    <arg name="pred_win_size" default="1"/>
    <arg name="pred_model_path" default="$(find rotors_gazebo)/pred_model_ckpt/"/>
    <arg name="logging" default="true"/>

    <!-- Central Processor -->
    <node pkg="rotors_gazebo" type="drone_central_node.py" name="central_processor" output="screen">
        <param name="drone_id" value="1"/>
        <param name="robot_num" value="$(arg robot_num)"/>
        <param name="target_num" value="$(arg target_num)"/>
        <param name="win_size" value="$(arg win_size)"/>
        <param name="pred_win_size" value="$(arg pred_win_size)"/>
        <param name="pred_model_path" value="$(arg pred_model_path)"/>
        <param name="log_path" value="$(find rotors_gazebo)/exp0_logs/"/>
        <param name="logging" value="$(arg logging)"/>
    </node>
    
</launch>





