<launch>
  <arg name="init_x" value="-4.0"/>
  <arg name="init_y" value="-4.0"/>
  <arg name="init_z" value="0.8"/> 
  <arg name="mav_name" default="hummingbird"/>
  <arg name="world_name" default="outdoor_with_random_actor"/>
  <arg name="enable_logging" default="false" />
  <arg name="enable_ground_truth" default="true" />
  <arg name="log_file" default="$(arg mav_name)" />
  <arg name="debug" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="verbose" default="false"/>

  <!-- Enable hovering example for auto takeoff (disable when using ego-planner goals) -->
  <arg name="enable_hovering" default="false"/>

  <!-- Ego-planner map parameters -->
  <arg name="map_size_x" default="100.0"/>
  <arg name="map_size_y" default="100.0"/>
  <arg name="map_size_z" default="10.0"/>
  
  <!-- Local update range - set to half map size for global persistent mapping -->
  <arg name="local_update_range_x" default="50.0"/>
  <arg name="local_update_range_y" default="50.0"/>
  <arg name="local_update_range_z" default="5.0"/>

  <!-- Odometry topic - use odometry sensor instead of ground truth -->
  <arg name="odom_topic" default="/$(arg mav_name)/odometry_sensor1/odometry" />

  <!-- Start Gazebo with world -->
  <env name="GAZEBO_MODEL_PATH" value="${GAZEBO_MODEL_PATH}:$(find rotors_gazebo)/models"/>
  <env name="GAZEBO_RESOURCE_PATH" value="${GAZEBO_RESOURCE_PATH}:$(find rotors_gazebo)/models"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find rotors_gazebo)/worlds/$(arg world_name).world" />
    <arg name="paused" value="true"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="$(arg debug)" />
    <arg name="verbose" value="false"/>
  </include>

  <group ns="$(arg mav_name)">
    <!-- Load and spawn the MAV model -->
    <include file="$(find rotors_gazebo)/launch/spawn_mav.launch">
      <arg name="mav_name" value="$(arg mav_name)" />
      <arg name="model" value="$(find rotors_description)/urdf/mav_with_aligned_depth_sensor.gazebo" />
      <arg name="enable_logging" value="$(arg enable_logging)" />
      <arg name="enable_ground_truth" value="$(arg enable_ground_truth)" />
      <arg name="log_file" value="$(arg log_file)"/>
      <arg name="x" value="$(arg init_x)"/>
      <arg name="y" value="$(arg init_y)"/>
      <arg name="z" value="$(arg init_z)"/>
    </include>

    <!-- Lee position controller -->
    <node name="lee_position_controller_node" pkg="rotors_control" type="lee_position_controller_node" output="screen">
      <rosparam command="load" file="$(find rotors_gazebo)/resource/lee_controller_$(arg mav_name).yaml" />
      <rosparam command="load" file="$(find rotors_gazebo)/resource/$(arg mav_name).yaml" />
      <remap from="odometry" to="odometry_sensor1/odometry" />
    </node>

    <!-- Hovering example to take off and maintain position (optional) -->
    <node name="hovering_example" pkg="rotors_gazebo" type="hovering_example" output="screen" if="$(arg enable_hovering)">
      <param name="init_state_x" value="$(arg init_x)"/>
      <param name="init_state_y" value="$(arg init_y)"/>
      <param name="init_state_z" value="$(arg init_z)"/>
    </node>

    <!-- Random Actor Controller for dynamic movement -->
    <node name="random_actor_controller" pkg="rotors_gazebo" type="random_actor_controller.py" output="screen" />

    <!-- Robot state publisher for TF -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

    <!-- RViz for visualization -->
    <node type="rviz" name="rviz" pkg="rviz" args="-d $(find rotors_gazebo)/launch/simulator.rviz" respawn="false" />
  </group>

  <!-- Ego-planner bridge (outside group to access global /planning/pos_cmd topic) -->
  <node name="ego_planner_bridge" pkg="rotors_control" type="ego_planner_bridge_node" output="screen" ns="$(arg mav_name)">
    <remap from="/planning/pos_cmd" to="/planning/pos_cmd"/>
  </node>

  <!-- Ego-planner -->
  <include file="$(find ego_planner)/launch/advanced_param.xml">
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    
    <!-- Local update range for persistent global mapping -->
    <arg name="local_update_range_x" value="$(arg local_update_range_x)"/>
    <arg name="local_update_range_y" value="$(arg local_update_range_y)"/>
    <arg name="local_update_range_z" value="$(arg local_update_range_z)"/>
    
    <arg name="odometry_topic" value="$(arg odom_topic)"/>

    <!-- Aligned depth camera settings -->
    <arg name="camera_pose_topic" value="/$(arg mav_name)/vi_sensor/camera_depth/camera_info"/>
        <!-- Depth topic for grid_map - use aligned camera which publishes proper depth images -->
    <arg name="depth_topic" value="/$(arg mav_name)/aligned/depth/image_raw"/>

    <!-- Point cloud topic (using aligned depth sensor point cloud) -->
    <!-- <arg name="cloud_topic" value="/$(arg mav_name)/vi_sensor/camera_depth/depth/points"/> -->

    <!-- Camera intrinsics for aligned depth sensor (adjust if needed) -->
    <arg name="cx" value="320.5"/>
    <arg name="cy" value="240.5"/>
    <arg name="fx" value="462.1379699707031"/>
    <arg name="fy" value="462.1379699707031"/>

    <!-- Velocity and acceleration limits -->
    <arg name="max_vel" value="2.0" />
    <arg name="max_acc" value="3.0" />

    <!-- Planning horizon -->
    <arg name="planning_horizon" value="7.5" /> 

    <!-- Flight type: 1 = use 2D Nav Goal, 2 = use waypoints -->
    <arg name="flight_type" value="1" />
    
    <!-- Waypoint parameters (required even if not used in manual mode) -->
    <arg name="point_num" value="2" />
    <arg name="point0_x" value="0.0" />
    <arg name="point0_y" value="0.0" />
    <arg name="point0_z" value="1.0" />
    <arg name="point1_x" value="1.0" />
    <arg name="point1_y" value="0.0" />
    <arg name="point1_z" value="1.0" />
    <arg name="point2_x" value="0.0" />
    <arg name="point2_y" value="0.0" />
    <arg name="point2_z" value="1.0" />
    <arg name="point3_x" value="0.0" />
    <arg name="point3_y" value="0.0" />
    <arg name="point3_z" value="1.0" />
    <arg name="point4_x" value="0.0" />
    <arg name="point4_y" value="0.0" />
    <arg name="point4_z" value="1.0" />
  </include>

  <!-- Trajectory server -->
  <node pkg="ego_planner" name="traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="planning/pos_cmd"/>
    <remap from="/odom_world" to="$(arg odom_topic)"/>
    <param name="traj_server/time_forward" value="1.0" type="double"/>
  </node>

  <!-- Waypoint generator -->
  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>        
    <remap from="~goal" to="/move_base_simple/goal"/>
    <remap from="~traj_start_trigger" to="/traj_start_trigger" />
    <param name="waypoint_type" value="manual-lonely-waypoint"/>    
  </node>

</launch>
