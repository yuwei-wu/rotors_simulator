<?xml version="1.0"?>
<!--
  Sensor/controller smoke test: hummingbird + aligned depth sensor, Lee
  controller, auto-hover takeoff — no planner involved. For the
  Ego-Planner-controlled version of this same setup, see
  rotors_with_ego_planner.launch. Shared bring-up lives in
  aligned_depth_sensor_base.launch.
-->
<launch>

  <arg name="init_x" default="-4.0"/>
  <arg name="init_y" default="-4.0"/>
  <arg name="init_z" default="0.8"/>
  <arg name="mav_name" default="hummingbird"/>
  <arg name="world_name" default="outdoor_with_random_actor"/>
  <arg name="enable_logging" default="false" />
  <arg name="enable_ground_truth" default="true" />
  <arg name="log_file" default="$(arg mav_name)" />
  <arg name="debug" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="verbose" default="false"/>

  <include file="$(find rotors_gazebo)/launch/aligned_depth_sensor_base.launch">
    <arg name="init_x" value="$(arg init_x)"/>
    <arg name="init_y" value="$(arg init_y)"/>
    <arg name="init_z" value="$(arg init_z)"/>
    <arg name="mav_name" value="$(arg mav_name)"/>
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="enable_logging" value="$(arg enable_logging)"/>
    <arg name="enable_ground_truth" value="$(arg enable_ground_truth)"/>
    <arg name="log_file" value="$(arg log_file)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="enable_hovering" value="true"/>
  </include>

</launch>
