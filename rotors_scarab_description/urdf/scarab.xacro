<?xml version="1.0"?>
<!--
    - Base      : create
    - Stacks    : circles
    - 3d Sensor : kinect
-->
<robot name="scarab" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="tf_prefix" default="scarab"/>
  <xacro:arg name="camera"    default="true"/>
  <xacro:arg name="hokuyo"    default="true"/>
  <xacro:arg name="gazebo_color" default="Gazebo/Orange"/>

  <xacro:include filename="$(find rotors_scarab_description)/urdf/common_properties.urdf.xacro"/>
  <xacro:include filename="$(find rotors_scarab_description)/urdf/turtlebot_properties.urdf.xacro"/>
  <xacro:include filename="$(find rotors_scarab_description)/urdf/kobuki.urdf.xacro" />
  <xacro:include filename="$(find rotors_scarab_description)/urdf/hexagons.urdf.xacro"/>

  <!-- 3D Sensors -->
  <xacro:include filename="$(find rotors_scarab_description)/urdf/sensors/kinect.urdf.xacro"/>
  <xacro:include filename="$(find rotors_scarab_description)/urdf/sensors/asus_xtion_pro.urdf.xacro"/>

  <xacro:kobuki/>
  <xacro:stack_hexagons parent="$(arg tf_prefix)/base_link" prefix="$(arg tf_prefix)"/>
  <xacro:if value="$(arg camera)">
    <xacro:sensor_kinect parent="$(arg tf_prefix)/base_link" prefix="$(arg tf_prefix)"/>
  </xacro:if>
  <xacro:if value="$(arg hokuyo)">
    <xacro:include filename="$(find rotors_scarab_description)/urdf/sensors/hokuyo.gazebo" />
  </xacro:if>

  <!-- Add a small colored patch on the top plate instead of tinting the whole robot. -->
  <joint name="$(arg tf_prefix)/color_patch_joint" type="fixed">
    <origin xyz="0.0 0.0 0.43" rpy="0 0 0"/>
    <parent link="$(arg tf_prefix)/base_link"/>
    <child link="$(arg tf_prefix)/color_patch_link"/>
  </joint>
  <link name="$(arg tf_prefix)/color_patch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.01"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>
  <gazebo reference="$(arg tf_prefix)/color_patch_link">
    <material>$(arg gazebo_color)</material>
  </gazebo>

</robot>
